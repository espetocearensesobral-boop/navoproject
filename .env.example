CRON_SECRET=
DATABASE_URL=
ENCRYPTION_KEY=
GEMINI_API_KEY=
JWT_SECRET=
SQL_DB_NAME=
SQL_HOST=
SQL_PASSWORD=
SQL_USER=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# Opcional: senhas para os usuários criados pelo seed inicial.
# Se não definidas, senhas aleatórias são geradas e impressas no log do servidor.
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
VITE_API_BASE_URL=
# Meta Ads: segredos somente no backend; redirect URI deve apontar para /api/meta-ads/oauth/callback.
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_REDIRECT_URI=
META_ADS_GRAPH_API_VERSION=v26.0
# Web Push administrativo: gerar um par VAPID e manter a chave privada apenas no servidor.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@navoproject.com
