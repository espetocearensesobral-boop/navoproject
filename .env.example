CRON_SECRET=
DATABASE_URL=
ENCRYPTION_KEY=
GEMINI_API_KEY=
JWT_SECRET=
SQL_DB_NAME=
SQL_HOST=
SQL_PASSWORD=
SQL_USER=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
# Opcional: senhas para os usuários criados pelo seed inicial.
# Se não definidas, senhas aleatórias são geradas e impressas no log do servidor.
SEED_ADMIN_PASSWORD=
SEED_CLIENT_PASSWORD=
VITE_API_BASE_URL=
# Campanhas ficam em modo demonstrativo por padrão; use false somente ao ativar as integrações reais.
VITE_CAMPAIGNS_DEMO_MODE=true
# Meta Ads: segredos somente no backend; redirect URI deve apontar para /api/meta-ads/oauth/callback.
META_ADS_APP_ID=
META_ADS_APP_SECRET=
META_ADS_REDIRECT_URI=
META_ADS_GRAPH_API_VERSION=v26.0
# Google Ads API: segredos somente no backend; callback deve apontar para /api/google-ads/oauth/callback.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_REDIRECT_URI=https://navoproject.vercel.app/api/google-ads/oauth/callback
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v25
# Web Push administrativo: gerar um par VAPID e manter a chave privada apenas no servidor.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:admin@navoproject.com
